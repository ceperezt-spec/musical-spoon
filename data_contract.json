{
  "contract_name": "iris_inference_contract",
  "version": "1.0.0",
  "description": "Contrato de datos oficial para la entrada de inferencia del modelo RandomForest entrenado con Iris.",
  "owner": "Cesar Andres Perez Tierradentro",
  "model": {
    "experiment": "Proyecto_Final_Grado",
    "artifact_path": "iris_model"
  },
  "input_schema": {
    "allow_extra_fields": false,
    "fields": {
      "sepal_length_cm": {"type": "float", "nullable": false, "min": 4.0, "max": 8.0, "description": "Largo del sépalo en cm"},
      "sepal_width_cm":  {"type": "float", "nullable": false, "min": 1.5, "max": 5.0, "description": "Ancho del sépalo en cm"},
      "petal_length_cm": {"type": "float", "nullable": false, "min": 0.5, "max": 7.5, "description": "Largo del pétalo en cm"},
      "petal_width_cm":  {"type": "float", "nullable": false, "min": 0.0, "max": 3.0, "description": "Ancho del pétalo en cm"}
    }
  },
  "output_schema": {
    "prediction": {"type": "int", "allowed_values": [0, 1, 2], "labels": {"0": "setosa", "1": "versicolor", "2": "virginica"}}
  },
  "examples": {
    "valid_input": {
      "sepal_length_cm": 5.1,
      "sepal_width_cm": 3.5,
      "petal_length_cm": 1.4,
      "petal_width_cm": 0.2
    },
    "invalid_input": {
      "sepal_length_cm": "cinco punto uno",
      "sepal_width_cm": null,
      "petal_length_cm": 99.0,
      "petal_width_cm": 0.2,
      "color": "azul"
    },
    "invalid_input_expected_errors": [
      "sepal_length_cm: tipo inválido (se esperaba float, llegó str)",
      "sepal_width_cm: valor nulo no permitido",
      "petal_length_cm: valor 99.0 fuera de rango [0.5, 7.5]",
      "color: campo no definido en el contrato"
    ]
  }
}
